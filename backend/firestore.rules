rules_version = '2';

// Floq Firestore security rules.
//
// Opened deliberately as each feature lands:
//   - owner-only read/write on users/{uid} + subcollections      -> M2.2
//   - create-only anonymized training samples                    -> L23
//   - partnership edge + invite-code install-and-pair + partner
//     read of social/summary + the two cross-tree grants (L30)   -> M7.0
//
// SAFETY (per CLAUDE.md): changes here must be backward-compatible and reviewed.
// LOOSENING any rule requires explicit sign-off. M7.0 adds two deliberate,
// scoped loosenings (signed off in the plan): an active partner may READ the
// owner's social/summary projection (NEVER sessions/tasks/raw user doc — L4
// holds), and a user may write OUTSIDE their own tree in exactly two cases — the
// pairing grant (create the counterpart's partner pointer on accept) and the
// L30 unpair grant (delete the pointer that names them). Both are emulator-tested.
//
// Every new match below is ADDITIVE: Firestore OR's across matching paths, so
// these grants cannot loosen the owner-only grant or the catch-all deny.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Sorted-UID pair id (matches partners.ts pairIdOf + the doc id convention).
    function pairIdOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // RELEASE GATE B predicate: the reader has an ACTIVE partnership with ownerUid.
    // One distinct document access (partnerships/{sortedPair}); exists()+get() to
    // the same path dedupe in the rules engine.
    function isPartner(ownerUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/partnerships/$(pairIdOf(request.auth.uid, ownerUid)))
        && get(/databases/$(database)/documents/partnerships/$(pairIdOf(request.auth.uid, ownerUid))).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/partnerships/$(pairIdOf(request.auth.uid, ownerUid))).data.members;
    }

    // M7.1 — partner read WITH share-consent (L28). Reuses the SAME partnership
    // doc isPartner already fetches, so the rules engine dedupes the get() →
    // +0 budget over isPartner. The map-level `.get('share_consent', {})` default
    // makes a pre-M7.1 partnership (no field) deny cleanly instead of erroring.
    function partnerCanRead(ownerUid) {
      return isPartner(ownerUid)
        && get(/databases/$(database)/documents/partnerships/$(pairIdOf(request.auth.uid, ownerUid)))
             .data.get('share_consent', {}).get(ownerUid, false) == true;
    }

    // The OTHER member of a partnership doc (for the consent-self-toggle freeze).
    function otherMemberOf(res, me) {
      return res.data.members[0] == me ? res.data.members[1] : res.data.members[0];
    }

    // M2.2 — owner-only on the user document and all owned subcollections.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // M7.0 GATE B + M7.1 consent. An active partner may READ the owner's
    // title-stripped session summary — but only once the owner has CONSENTED
    // (partnerCanRead). ADDITIVE to the owner's recursive grant; writes stay
    // owner-only (the M7.1 writer is owner-self). The partner has NO read match
    // for sessions/{id}, tasks/**, the raw users/{uid} doc, or the partner
    // pointer, so all of those stay DENIED (L4 holds).
    match /users/{ownerUid}/social/summary {
      allow read: if isSignedIn() && (request.auth.uid == ownerUid || partnerCanRead(ownerUid));
    }

    // M7.1 — partner-visible display-name projection. Gated on isPartner WITHOUT
    // consent (per L28 the consent flag covers focus ACTIVITY — summaries +
    // presence — not identity): a partner can see your NAME the moment you pair
    // (you invited them; powers the dormant "{name} joined" state), but not your
    // minutes/score/live-state until you consent. Writes are owner-only via the
    // recursive grant (the projection writer is owner-self).
    match /users/{ownerUid}/social/profile {
      allow read: if isSignedIn() && (request.auth.uid == ownerUid || isPartner(ownerUid));
    }

    // M7.2 — one-tap fire/clap reaction on a partner's finished session. Doc id ==
    // the REACTOR's uid (idempotent: a re-react overwrites; one live reaction per
    // direction). The OWNER's own read/write/delete rides the recursive users/{uid}
    // grant; this match ADDS the cross-tree reactor cases. get budget: 1 (the
    // partnership, via partnerCanRead — reuses the doc isPartner fetches, +0).
    match /users/{ownerUid}/reactions/{reactorUid} {
      // Owner reads received reactions via the recursive grant; this adds the
      // reactor reading their own (to know they already reacted).
      allow read: if isSignedIn()
        && (request.auth.uid == ownerUid || request.auth.uid == reactorUid);

      // Cross-tree create/update: only the reactor, never self-react, only to a
      // session they're ALLOWED TO SEE (partnerCanRead == consent + active edge).
      // hasAll pins presence (so kind can't be omitted); hasOnly bounds the keys.
      allow create, update: if isSignedIn()
        && request.auth.uid == reactorUid
        && request.auth.uid != ownerUid
        && partnerCanRead(ownerUid)
        && request.resource.data.keys().hasAll(['kind', 'reacted_at', 'session_ended_at'])
        && request.resource.data.keys().hasOnly(['kind', 'reacted_at', 'session_ended_at'])
        && request.resource.data.kind in ['fire', 'clap']
        && request.resource.data.reacted_at == request.time
        && request.resource.data.session_ended_at is timestamp;

      // UNGATED reactor delete — a reactor can always remove their OWN reaction,
      // even after the partnership ends (load-bearing for the wipe/unpair cleanup).
      // Owner delete rides the recursive grant.
      allow delete: if isSignedIn() && request.auth.uid == reactorUid;
    }

    // M7.1 — coarse live presence. Owner write/delete; a CONSENTED active partner
    // reads. Staleness/decay is a client concern (derivePresence) — the rule just
    // gates WHO can read whatever state is stored.
    match /presence/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || partnerCanRead(uid));
      allow write, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // M7.0 — the singleton partner pointer. The owner's own read/write/delete
    // rides the recursive users/{uid} grant above; this exact-path match ADDS
    // the two cross-tree cases (the only writes a user makes outside their tree).
    match /users/{ownerUid}/partner/current {

      // CROSS-TREE PAIRING GRANT — the accepter creates the counterpart's
      // pointer as part of acceptInvite. Gated on a valid, unexpired, pending
      // invite FROM ownerUid (the committed proof that ownerUid consented to
      // pair). Create-only => the target pointer must have been empty.
      // get budget: 1 distinct document (the invite).
      allow create: if isSignedIn()
        && request.auth.uid != ownerUid
        && request.resource.data.partner_uid == request.auth.uid
        && request.resource.data.pair_id == pairIdOf(request.auth.uid, ownerUid)
        && request.resource.data.since == request.time
        && request.resource.data.invite_code is string
        && request.resource.data.keys().hasOnly(['pair_id', 'partner_uid', 'since', 'invite_code'])
        && exists(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code))
        && get(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code)).data.from_uid == ownerUid
        && get(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code)).data.status == 'pending'
        && request.time < get(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code)).data.expires_at;

      // CROSS-TREE UNPAIR GRANT (L30) — a member ends the partnership by tearing
      // down the pointer that names THEM as the partner. get budget: 0.
      allow delete: if isSignedIn() && resource.data.partner_uid == request.auth.uid;
    }

    // M7.0 — partner invites. inviteId === the normalized 6-char code, so the
    // code is the secret that addresses the invite (get-by-id only; no list, so
    // codes can't be enumerated). get()/exists() budget: 0 (keys off resource).
    match /partner_invites/{inviteId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.from_uid == request.auth.uid
        && request.resource.data.code == inviteId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['code', 'from_uid', 'status', 'created_at', 'expires_at'])
        && request.resource.data.created_at == request.time
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at < request.time + duration.value(73, 'h'); // ≤72h + clock-skew slack

      // Two transitions off a still-pending invite, immutables frozen:
      //  (i)  issuer revokes/expires;  (ii) accepter marks accepted, stamping self.
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.from_uid == resource.data.from_uid
        && request.resource.data.code == resource.data.code
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.expires_at == resource.data.expires_at
        && (
          ( request.auth.uid == resource.data.from_uid
            && request.resource.data.status in ['revoked', 'expired']
            && request.resource.data.keys().hasOnly(['code', 'from_uid', 'status', 'created_at', 'expires_at'])
          )
          ||
          ( request.auth.uid != resource.data.from_uid
            && request.time < resource.data.expires_at
            && request.resource.data.status == 'accepted'
            && request.resource.data.accepted_by == request.auth.uid
            && request.resource.data.keys().hasOnly(['code', 'from_uid', 'status', 'accepted_by', 'created_at', 'expires_at'])
          )
        );

      allow delete: if false; // invites are revoked (status), never hard-deleted
    }

    // M7.0 — the partnership edge. pairId == sorted(members).join('_').
    match /partnerships/{pairId} {

      // RELEASE GATE A — the partnership-CREATE rule. Proven UNDER the Spark
      // 10-get()/rule cap: 3 distinct document accesses (the invite + both
      // members' partner pointers); the multiple get()s of the invite path
      // dedupe to one. Over-cap would make EVERY acceptInvite fail and zero the
      // Axis-A read, so the emulator A1 success is the literal proof.
      allow create: if isSignedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.status == 'active'
        && request.resource.data.created_at == request.time
        && request.resource.data.pair_streak_days == 0
        && request.resource.data.invite_code is string
        && request.resource.data.share_consent == {} // M7.1 — default-OFF (L28); empty at create
        && request.resource.data.keys().hasOnly(['members', 'status', 'created_at', 'pair_streak_days', 'invite_code', 'share_consent'])
        // a committed, pending, unexpired invite FROM the other member:
        && exists(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code))
        && get(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code)).data.from_uid
             == (request.auth.uid == request.resource.data.members[0]
                  ? request.resource.data.members[1]
                  : request.resource.data.members[0])
        && get(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code)).data.status == 'pending'
        && request.time < get(/databases/$(database)/documents/partner_invites/$(request.resource.data.invite_code)).data.expires_at
        // neither member already paired (the singleton-pointer invariant):
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.members[0])/partner/current)
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.members[1])/partner/current);

      allow get, list: if isSignedIn() && request.auth.uid in resource.data.members;

      // Members-only updates, immutables (members/created_at/invite_code) frozen.
      // Three branches: (a) streak-only, (b) the L30 end transition, (c) the M7.1
      // consent-self-toggle. CRITICAL: (a) and (b) must FREEZE share_consent, else
      // the streak branch is a back door to flip the OTHER member's consent bit —
      // branch (c)'s otherUid freeze would be moot. (`.get('share_consent', {})`
      // tolerates a legacy doc with no field.)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.invite_code == resource.data.invite_code
        && (
          // (a) streak-only — status + consent frozen.
          ( request.resource.data.status == resource.data.status
            && request.resource.data.get('share_consent', {}) == resource.data.get('share_consent', {})
            && request.resource.data.keys().hasOnly(['members', 'status', 'created_at', 'pair_streak_days', 'invite_code', 'share_consent'])
          )
          ||
          // (b) L30 end transition (active -> ended, optional self-block) — consent frozen.
          ( resource.data.status == 'active'
            && request.resource.data.status == 'ended'
            && request.resource.data.get('share_consent', {}) == resource.data.get('share_consent', {})
            && request.resource.data.keys().hasOnly(['members', 'status', 'created_at', 'pair_streak_days', 'invite_code', 'share_consent', 'blocked_by', 'ended_at'])
            && (!('blocked_by' in request.resource.data) || request.resource.data.blocked_by == request.auth.uid)
          )
          ||
          // (c) consent-self-toggle — change ONLY my own key; status + streak + the
          // other member's key all frozen; no stray keys in the map.
          ( request.resource.data.status == resource.data.status
            && request.resource.data.pair_streak_days == resource.data.pair_streak_days
            && request.resource.data.keys().hasOnly(['members', 'status', 'created_at', 'pair_streak_days', 'invite_code', 'share_consent'])
            && request.resource.data.share_consent is map
            && request.resource.data.share_consent[request.auth.uid] is bool
            && request.resource.data.share_consent.keys().hasOnly(resource.data.members)
            && request.resource.data.share_consent.get(otherMemberOf(resource, request.auth.uid), false)
                 == resource.data.get('share_consent', {}).get(otherMemberOf(resource, request.auth.uid), false)
          )
        );

      allow delete: if false; // partnerships are ended (status), never hard-deleted
    }

    // L23 — anonymized ML training samples. Create-only, strict shape (no uid /
    // task title / free text — the L4 invariant at the boundary).
    match /training_samples/{sampleId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'features', 'focus_score', 'actual_focus_minutes',
             'planned_focus_minutes', 'task_completed', 'regime',
             'model_version', 'client_version', 'created_at'
           ])
        && request.resource.data.features is list
        && request.resource.data.features.size() == 13
        && request.resource.data.regime in ['cold', 'warming', 'mature'];
      allow read, update, delete: if false;
    }

    // M7.2 — always-on first-party analytics funnel sink (NO consent gate — this
    // is the W8 Axis-A instrument; gating it default-OFF would zero the funnel).
    // Create-only, strict shape. UNLIKE training_samples this doc is uid-LINKED
    // (carries `uid`) and is NOT wiped (create-only by design). The L4 boundary:
    // `name` is a bounded enum string + `props` a shallow primitive map, both
    // client-disciplined — a rule cannot deep-inspect a map, so this caps the
    // blast radius (no titles / free text / display name).
    match /analytics_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'ts', 'seq', 'kind', 'props'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'ts', 'seq', 'kind', 'props'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.kind is string
        && request.resource.data.kind.size() <= 32
        && request.resource.data.props is map
        && request.resource.data.props.size() <= 16
        && request.resource.data.ts is number
        && request.resource.data.seq is number;
      allow read, update, delete: if false;
    }

    // Everything else stays denied until its feature lands.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
